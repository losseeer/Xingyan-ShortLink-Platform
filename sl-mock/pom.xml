<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xingyan.shortlink</groupId>
        <artifactId>xingyan-shortlink</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>sl-mock</artifactId>
    <name>sl-mock</name>
    <description>mock 宣发平台：接收归因回传（验签 + 校验和 + batch_id 幂等）与假订单接口（DESIGN 7.3/附录 B，M3-03）</description>

    <dependencies>
        <dependency>
            <groupId>com.xingyan.shortlink</groupId>
            <artifactId>sl-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 台账与统计落 MySQL 独立库 xsl_mock：这里是"外部平台"的等价物，不该和我们的业务分片共库，
             也刻意**不经 ShardingSphere**（它不分片，普通 JDBC 就够，少一层就少一类"看起来是框架的锅"）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 与 admin/gateway/consumer 同一条教训：expose 了 prometheus 就必须引注册器，
             否则 /actuator/prometheus 是 404，指标只存在于文档里（见 ITER-M3 §4）。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
